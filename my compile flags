# To compile all three independent object files and link the isolated validation binary:
make

# To build the general-form shared library exporting all 3 public core functions:
make shared

# To pass a custom, high-speed release override with aggressive loop-unrolling and error traps:
make shared CC=clang CFLAGS="-O3 -std=c11 -fPIC -Werror -march=native" LIB_NAME="libxplane_core"
